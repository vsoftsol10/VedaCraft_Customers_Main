# ================================
# SUPABASE CONFIGURATION
# ================================
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Prisma uses this direct Postgres URL for schema migrations and product detail storage.
# For Supabase, use the connection string from Project Settings -> Database.
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# ================================
# SERVER CONFIGURATION
# ================================
PORT=5000
NODE_ENV=development

# ================================
# CORS CONFIGURATION
# ================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://test.vedacraftscommunity.in,https://vedacraftscommunity.in,https://www.vedacraftscommunity.in

# ================================
# RATE LIMITING
# ================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# LOGGING
# ================================
LOG_LEVEL=dev

# ================================
# EMAIL / OTP
# ================================
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email
BREVO_SENDER_NAME=VedaCraft

# ================================
# AI CHATBOT
# ================================
# Optional. If this is not set, the chatbot returns local fallback replies.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
